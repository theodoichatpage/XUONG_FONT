{
  "name": "xuong-font",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild site/app.js --bundle --minify --format=iife --outfile=dist/app.js --external:node:fs --external:wawoff2 && node scripts/copy-static.cjs",
    "check:font": "fontbakery check-typenetwork -n -c outline_alignment_miss -c outline_colinear_vectors -c outline_jaggy_segments -c outline_semi_vertical -c outline_short_segments",
    "check:quality": "node scripts/check-font-quality.cjs",
    "check:family": "node scripts/check-family.cjs",
    "check:reconstruction": "node scripts/check-reconstruction.cjs",
    "check:fidelity": "node scripts/check-reference-fidelity.cjs",
    "check:inputs": "node scripts/check-family-inputs.cjs",
    "check:clean": "node scripts/check-clean-reference.cjs",
    "check:outline": "node scripts/check-outline-cleanup.cjs && node scripts/check-outline-ui.cjs",
    "check:corners": "node scripts/check-sharp-corners.cjs && node scripts/check-sharp-reference.cjs"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "esm-potrace-wasm": "0.5.0",
    "opentype.js": "^1.3.4",
    "svg2ttf": "6.0.3",
    "svgpath": "2.6.0",
    "ttf2woff": "3.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "esbuild": "0.28.1"
  }
}
